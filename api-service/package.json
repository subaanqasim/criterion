{
  "name": "criterion-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quran and Hadith search API",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/tests/*.test.js",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:seed": "node dist/scripts/seed.js",
    "db:embed": "node dist/scripts/embed.js",
    "railway:seed": "bash scripts/railway-db-task.sh seed",
    "railway:embed": "bash scripts/railway-db-task.sh embed"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.22",
    "ai": "^6.0.77",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22"
  }
}
